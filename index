function renderStats() {
  const days7=getLast7();
  let totalChecks=0,perfectDays=0,allDays=Object.keys(habitData).length;
  Object.entries(habitData).forEach(([dk,dd])=>{
    totalChecks+=Object.values(dd).filter(Boolean).length;
    const dow=new Date(dk+'T12:00:00').getDay();
    const dh=HABITS.filter(h=>h.days==='daily'||h.days.includes(dow));
    if(dh.length&&dh.every(h=>dd[h.id]))perfectDays++;
  });

  document.getElementById('stats-grid').innerHTML=`
    <div class="stat-card"><div class="stat-num">${getStreak()}</div><div class="stat-label">Day Streak</div></div>
    <div class="stat-card"><div class="stat-num">${perfectDays}</div><div class="stat-label">Perfect Days</div></div>
    <div class="stat-card"><div class="stat-num">${totalChecks}</div><div class="stat-label">Total Check-ins</div></div>
    <div class="stat-card"><div class="stat-num">${allDays}</div><div class="stat-label">Days Tracked</div></div>`;

  const DAY_LETTERS=['S','M','T','W','T','F','S'];
  const histEl=document.getElementById('history-list');
  histEl.innerHTML='';

  HABITS.forEach(habit=>{
    let streak=0;
    for(let i=days7.length-1;i>=0;i--){
      const dk=days7[i];
      const dow=new Date(dk+'T12:00:00').getDay();
      const rel=habit.days==='daily'||habit.days.includes(dow);
      if(rel&&habitData[dk]?.[habit.id])streak++;
      else if(rel)break;
    }
    const bars=days7.map(dk=>{
      const dow=new Date(dk+'T12:00:00').getDay();
      const rel=habit.days==='daily'||habit.days.includes(dow);
      const filled=rel&&habitData[dk]?.[habit.id];
      return `<div class="wbd ${filled?'filled':''}" style="${filled?`background:${habit.color};color:white`:''}">
        <span class="dl">${DAY_LETTERS[dow]}</span>${filled?'✓':rel?'·':''}
      </div>`;
    }).join('');
    const card=document.createElement('div');
    card.className='history-card';
    card.innerHTML=`
      <div class="history-top">
        <div class="history-name">${habit.emoji} ${habit.name}</div>
        <div class="history-streak" style="color:${habit.color}">${streak}<span style="font-size:10px;color:var(--muted);font-weight:600"> /7</span></div>
      </div>
      <div class="week-bar">${bars}</div>`;
    histEl.appendChild(card);
  });
}

