function updateSet(exId, s, field, val) {
  if(!workoutData[exId]) workoutData[exId]={};
  if(!workoutData[exId][`set${s}`]) workoutData[exId][`set${s}`]={};
  workoutData[exId][`set${s}`][field]=val;
}
function toggleSetDone(exId, s) {
  if(!workoutData[exId]) workoutData[exId]={};
  if(!workoutData[exId][`set${s}`]) workoutData[exId][`set${s}`]={};
  const cur = workoutData[exId][`set${s}`].done||false;
  const rEl=document.getElementById(`reps-${exId}-${s}`);
  const wEl=document.getElementById(`weight-${exId}-${s}`);
  if(rEl?.value) workoutData[exId][`set${s}`].reps=rEl.value;
  if(wEl?.value) workoutData[exId][`set${s}`].weight=wEl.value;
  workoutData[exId][`set${s}`].done=!cur;
  document.getElementById(`done-${exId}-${s}`).classList.toggle('done',!cur);
  document.getElementById(`row-${exId}-${s}`).classList.toggle('completed',!cur);
}

async function saveWorkout() {
  if(!currentUser){showToast('Set your name first!');openUserModal();return;}
  if(!exercises.length){showToast('Add some exercises first!');return;}
  exercises.forEach(ex=>{
    [1,2,3].forEach(s=>{
      const rEl=document.getElementById(`reps-${ex.id}-${s}`);
      const wEl=document.getElementById(`weight-${ex.id}-${s}`);
      if(rEl?.value||wEl?.value){
        if(!workoutData[ex.id])workoutData[ex.id]={};
        if(!workoutData[ex.id][`set${s}`])workoutData[ex.id][`set${s}`]={};
        if(rEl?.value)workoutData[ex.id][`set${s}`].reps=rEl.value;
        if(wEl?.value)workoutData[ex.id][`set${s}`].weight=wEl.value;
      }
    });
  });
  const date=sessionKey();
  await sSet(woKey(currentUser,date),{user:currentUser,date,phase:currentPhase,data:workoutData,ts:Date.now()});
  const log=await sGet(logKey())||[];
  const summary=buildSummary();
  const entry={user:currentUser,date,phase:currentPhase,ts:Date.now(),summary};
  const idx=log.findIndex(e=>e.user===currentUser&&e.date===date);
  if(idx>=0)log[idx]=entry;else log.unshift(entry);
  await sSet(logKey(),log.sort((a,b)=>b.ts-a.ts).slice(0,50));
  const btn=document.getElementById('save-btn');
  btn.classList.add('saved');
  btn.innerHTML=`<svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg> Saved!`;
  setTimeout(()=>{btn.classList.remove('saved');btn.innerHTML=`<svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg> Save Workout`;},2500);
  showToast('Workout saved 🔥');
  loadFriendLog();
}

function buildSummary() {
  return exercises.map(ex=>{
    const done=[1,2,3].filter(s=>workoutData[ex.id]?.[`set${s}`]?.done).length;
    return done?`${ex.name} ×${done}`:null;
  }).filter(Boolean).join(' · ')||'Logged workout';
}

async function loadWorkout() {
  if(!currentUser)return;
  const saved=await sGet(woKey(currentUser,sessionKey()));
  workoutData=saved?.data||{};
  if(saved?.phase!==undefined){currentPhase=saved.phase;document.querySelectorAll('.phase-tab').forEach((t,i)=>t.classList.toggle('active',i===currentPhase));}
  renderExercises();
}

async function loadFriendLog() {
  const log=await sGet(logKey())||[];
  const container=document.getElementById('friend-log');
  if(!log.length){container.innerHTML=`<div class="friend-entry" style="justify-content:center;color:var(--muted);font-size:12px;font-weight:500;padding:18px;">No workouts logged yet. Be first! 🏆</div>`;return;}
  container.innerHTML=log.slice(0,8).map(e=>{
    const color=hashColor(e.user);
    const phase=['Feel It','Load It','Own It'][e.phase]||'';
    const tags=e.summary.split(' · ').map(s=>`<span class="friend-tag">${s}</span>`).join('');
    return `<div class="friend-entry">
      <div class="friend-avatar" style="background:${color}">${initials(e.user)}</div>
      <div class="friend-details">
        <div class="friend-name-row"><div class="friend-name">${e.user}</div><div class="friend-time">${timeAgo(e.ts)}</div></div>
        <div class="friend-summary">${phase?phase+' · ':''}${e.date}</div>
        <div class="friend-tags">${tags}</div>
      </div>
    </div>`;
  }).join('');
}

