function todayKey() { return new Date().toISOString().slice(0,10); }
function sessionKey() { const d=new Date();d.setDate(d.getDate()+sessionOffset);return d.toISOString().slice(0,10); }
function habitKey() { const d=new Date();d.setDate(d.getDate()+habitOffset);return d.toISOString().slice(0,10); }
function woKey(u,d) { return `mv26_wo_${u.replace(/\s/g,'_')}_${d}`; }
function habitStoreKey() { return 'mv26_habits_v1'; }
function logKey() { return 'mv26_activity_log'; }
function uid() { return Math.random().toString(36).slice(2,8); }
function nextColor() { return EARTHY[exercises.length % EARTHY.length]; }
function hashColor(s) { let h=0;for(let c of s)h=(h*31+c.charCodeAt(0))&0xffffffff;return AVATARS[Math.abs(h)%AVATARS.length]; }
function initials(n) { return n.split(' ').map(w=>w[0]).join('').toUpperCase().slice(0,2); }

function offsetToDate(offset) {
  const d = new Date(); d.setDate(d.getDate() + offset); return d;
}

function updateHabitDateNav() {
  const d = offsetToDate(habitOffset);
  const isToday = habitOffset === 0;
  document.getElementById('habit-date-day').textContent = d.toLocaleDateString('en-US',{weekday:'long'});
  document.getElementById('habit-date-full').textContent = d.toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'});
  document.getElementById('habit-today-badge').style.display = isToday ? 'inline-block' : 'none';
  document.getElementById('habit-next').classList.toggle('disabled', habitOffset >= 0);
  document.getElementById('habits-section-label').textContent = isToday ? "Today's Habits" : d.toLocaleDateString('en-US',{weekday:'long',month:'short',day:'numeric'}) + " — Habits";
  const banner = document.getElementById('all-done-banner');
  banner.querySelector('.all-done-title').textContent = isToday ? '🌿 All done today!' : '🌿 All done that day!';
  banner.querySelector('.all-done-sub').textContent = isToday ? 'Every habit checked. You\'re building something real.' : 'You crushed it on ' + d.toLocaleDateString('en-US',{weekday:'long'}) + '.';
}

function updateWorkoutDateNav() {
  const d = offsetToDate(sessionOffset);
  const isToday = sessionOffset === 0;
  document.getElementById('wo-date-day').textContent = d.toLocaleDateString('en-US',{weekday:'long'});
  document.getElementById('wo-date-full').textContent = d.toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'});
