.quote-logo span { color: var(–green); }
.quote-leaf { font-size: 44px; margin-bottom: 30px; }
.quote-text { font-size: 22px; font-weight: 700; color: var(–text); line-height: 1.45; letter-spacing: -0.02em; text-align: center; margin-bottom: 20px; max-width: 340px; }
.quote-author { font-size: 13px; font-weight: 600; color: var(–muted); letter-spacing: 0.05em; text-align: center; margin-bottom: 60px; }
.quote-dismiss { width: 100%; max-width: 340px; background: var(–green); color: white; border: none; border-radius: var(–r); padding: 20px; font-family: ‘Manrope’, sans-serif; font-size: 17px; font-weight: 700; cursor: pointer; }
.quote-dismiss:active { opacity: 0.82; }
.quote-skip { margin-top: 18px; font-size: 13px; font-weight: 600; color: var(–muted); cursor: pointer; letter-spacing: 0.04em; }

/* ACTIVITY FEED */
.activity-section { padding: 0 var(–pad); }
.friend-log { background: var(–surface); border: 1.5px solid var(–border); border-radius: var(–r); overflow: hidden; }
