const QUOTE_EMOJIS = ['🌿','🌱','🔥','⚡','🎯','💪','🌅','✨','🧠','🏔️'];

function showDailyQuote() {
  const today = todayKey();
  const lastSeen = lGet('mv26_quote_seen');
  if(lastSeen === today) return; // already shown today

  // Pick quote based on day-of-year for variety (not random, same quote all day)
  const start = new Date(new Date().getFullYear(), 0, 0);
  const dayOfYear = Math.floor((new Date() - start) / 86400000);
  const quote = QUOTES[dayOfYear % QUOTES.length];
  const emoji = QUOTE_EMOJIS[dayOfYear % QUOTE_EMOJIS.length];

  const overlay = document.getElementById('quote-overlay');
  document.getElementById('quote-text').textContent = `"${quote.text}"`;
  document.getElementById('quote-author').textContent = `— ${quote.author}`;
  document.getElementById('quote-leaf').textContent = emoji;
  document.getElementById('quote-date-badge').textContent =
    new Date().toLocaleDateString('en-US',{weekday:'long',month:'long',day:'numeric'});

  overlay.classList.remove('hidden');
  requestAnimationFrame(() => {
    requestAnimationFrame(() => overlay.classList.add('visible'));
  });
}

function dismissQuote() {
  lSet('mv26_quote_seen', todayKey());
  const overlay = document.getElementById('quote-overlay');
  overlay.classList.remove('visible');
  setTimeout(() => overlay.classList.add('hidden'), 400);
}

