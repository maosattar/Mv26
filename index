async function init() {
  const now = new Date();
  const dateStr = now.toLocaleDateString('en-US',{weekday:'long',month:'long',day:'numeric'});
  document.getElementById('habits-date').textContent = dateStr;
  document.getElementById('workout-date').textContent = dateStr;
  updateHabitDateNav();
  updateWorkoutDateNav();

  exercises = lGet('mv26_exercises') || [];
  habitData = lGet(habitStoreKey()) || {};
  loadProfileData();

  if(!currentUser) {
    document.getElementById('modal-user').classList.remove('hidden');
  } else {
    document.getElementById('user-display').textContent = currentUser;
    document.getElementById('user-display-2').textContent = currentUser;
  }

  if(!exercises.length && !lGet('mv26_program_asked')) {
    if(currentUser) document.getElementById('modal-program').classList.remove('hidden');
  }

  const isIOS = /iphone|ipad/i.test(navigator.userAgent);
  const isStandalone = window.navigator.standalone;
  if(isIOS && !isStandalone && !lGet('mv26_install_dismissed')) {
    document.getElementById('install-banner').classList.remove('hidden');
  }

  renderHabits();
  renderExercises();

  if(currentUser) await loadWorkout();
  await loadFriendLog();

  document.getElementById('loading').classList.add('hidden');

  // Show daily quote after a brief pause
  setTimeout(showDailyQuote, 300);
}

init();
