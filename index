function getHabitsForOffset(offset) {
  const d = new Date(); d.setDate(d.getDate() + offset);
  const dow = d.getDay();
  return HABITS.filter(h => h.days === 'daily' || h.days.includes(dow));
}

function isChecked(id) { return !!(habitData[habitKey()]?.[id]); }

function toggleHabit(id, cardEl) {
  const key = habitKey();
  if (!habitData[key]) habitData[key] = {};
  const was = !!habitData[key][id];
  habitData[key][id] = !was;
  lSet(habitStoreKey(), habitData);
  if (!was) { cardEl.classList.add('done'); spawnBurst(cardEl); }
  else cardEl.classList.remove('done');
  updateProgress();
}

function spawnBurst(el) {
  const emojis = ['✨','🌿','🔥','⚡','🎯'];
  const rect = el.getBoundingClientRect();
  const b = document.createElement('div');
  b.className = 'burst'; b.textContent = emojis[Math.floor(Math.random()*emojis.length)];
  b.style.left = (rect.left + rect.width/2 - 10) + 'px';
  b.style.top = (rect.top + rect.height/2 - 10) + 'px';
  document.body.appendChild(b); setTimeout(() => b.remove(), 600);
}

function getLast7() {
  const days = [];
  for (let i=6;i>=0;i--) { const d=new Date();d.setDate(d.getDate()-i);days.push(d.toISOString().slice(0,10)); }
  return days;
}

function getStreak() {
  let streak = 0;
  for (let i=0;i<365;i++) {
    const d=new Date();d.setDate(d.getDate()-i);
    const key=d.toISOString().slice(0,10);
    const dow=d.getDay();
    const dh=HABITS.filter(h=>h.days==='daily'||h.days.includes(dow));
    if(!dh.length){streak++;continue;}
    const checked=habitData[key]?dh.filter(h=>habitData[key][h.id]).length:0;
    if(checked===dh.length)streak++;
    else if(i===0)break;
    else break;
  }
  return streak;
}

function updateProgress() {
  const viewingH = getHabitsForOffset(habitOffset);
  const key = habitKey();
  const done = viewingH.filter(h => !!(habitData[key]?.[h.id])).length;
  const total = viewingH.length;
  const pct = total ? Math.round(done/total*100) : 0;
  document.getElementById('progress-fill').style.width = pct + '%';
  document.getElementById('progress-pct').textContent = pct + '%';
  document.getElementById('done-count').textContent = done;
  document.getElementById('total-count').textContent = total;
  document.getElementById('total-streak').textContent = getStreak();
  const banner = document.getElementById('all-done-banner');
  banner.classList.toggle('show', done === total && total > 0);
}

function renderHabits() {
  const list = document.getElementById('habits-list');
  list.innerHTML = '';
  const days7 = getLast7();
  const viewingH = getHabitsForOffset(habitOffset);
  const key = habitKey();

  viewingH.forEach((habit, idx) => {
    const checked = !!(habitData[key]?.[habit.id]);
    const dotsHtml = days7.map((dk, i) => {
      const dow = new Date(dk+'T12:00:00').getDay();
      const rel = habit.days==='daily' || habit.days.includes(dow);
      const isSelectedDay = dk === key;
      if(!rel) return `<div class="dot" style="opacity:0.15"></div>`;
      const filled = habitData[dk]?.[habit.id];
      if(isSelectedDay) return `<div class="dot ${filled?'filled':'today'}" style="--color:${habit.color}"></div>`;
      return `<div class="dot ${filled?'filled':''}" style="--color:${habit.color}"></div>`;
    }).join('');

    const card = document.createElement('div');
    card.className = 'habit-card' + (checked ? ' done' : '');
    card.style.setProperty('--color', habit.color);
    card.style.animationDelay = `${idx*0.04}s`;
    card.innerHTML = `
      <div class="habit-emoji">${habit.emoji}</div>
      <div class="habit-info">
        <div class="habit-name">${habit.name}</div>
        <div class="habit-meta">${habit.meta}</div>
        <div class="week-dots">${dotsHtml}</div>
      </div>
      <div class="check-circle">
        <svg width="12" height="12" fill="none" stroke="white" stroke-width="2.5" viewBox="0 0 14 14">
          <path d="M2.5 7L5.5 10L11.5 4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>`;
    card.addEventListener('click', () => toggleHabit(habit.id, card));
    list.appendChild(card);
  });
  updateProgress();
}

async function loadHabitData() {
  habitData = lGet(habitStoreKey()) || {};
  renderHabits();
}

