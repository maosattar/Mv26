  document.getElementById('profile-avatar').textContent = initials(name) || '?';
  document.getElementById('profile-name-display').textContent = name || 'Set your name';

  renderCustomHabitsList();
  renderMeasurementSpots();
  renderMeasurementHistory();
  renderWeightHistory();
}

// ── CUSTOM HABITS LIST ──
function renderCustomHabitsList() {
  const container = document.getElementById('custom-habits-list');
  // Show built-in habits first, then custom
  const allHabits = [
    ...HABITS.map(h => ({...h, isBuiltIn: true, enabled: true})),
    ...customHabits
  ];

  if(!allHabits.length) {
    container.innerHTML = `<div style="padding:16px 14px;font-size:12px;color:var(--muted);font-weight:500;">No habits yet. Tap + Add to create one.</div>`;
    return;
  }

  container.innerHTML = allHabits.map(h => {
    const daysLabel = h.days === 'daily' ? 'Every day' : (Array.isArray(h.days) ? h.days.map(d => DAY_FULL[d]).join(', ') : 'Daily');
    const isEnabled = h.isBuiltIn ? true : (h.enabled !== false);
    const editBtn = h.isBuiltIn ? '' : `<button class="habit-row-edit" onclick="openEditHabitModal('${h.id}')">✎</button>`;
    const toggle = h.isBuiltIn
      ? `<button class="habit-toggle on" style="opacity:0.4;pointer-events:none"></button>`
      : `<button class="habit-toggle ${isEnabled?'on':''}" onclick="toggleCustomHabit('${h.id}')"></button>`;
    return `<div class="custom-habit-row">
      <div class="habit-row-emoji">${h.emoji}</div>
      <div class="habit-row-info">
        <div class="habit-row-name">${h.name}</div>
        <div class="habit-row-days">${daysLabel}${h.meta?' · '+h.meta:''}</div>
      </div>
      ${toggle}
      ${editBtn}
    </div>`;
  }).join('');
}

function toggleCustomHabit(id) {
  const h = customHabits.find(h => h.id === id);
  if(h) { h.enabled = !(h.enabled !== false); saveProfileData(); renderCustomHabitsList(); }
}

// ── ADD/EDIT HABIT MODAL ──
function openAddHabitModal() {
  editingHabitId = null;
  selectedDays = [0,1,2,3,4,5,6]; // default all
  document.getElementById('habit-modal-title').textContent = 'Add Habit';
  ['h-name','h-emoji','h-meta'].forEach(id => document.getElementById(id).value = '');
  updateDayPicker();
  document.getElementById('modal-habit').classList.remove('hidden');
  setTimeout(() => document.getElementById('h-name').focus(), 150);
}

function openEditHabitModal(id) {
  const h = customHabits.find(h => h.id === id);
  if(!h) return;
  editingHabitId = id;
  selectedDays = h.days === 'daily' ? [0,1,2,3,4,5,6] : [...h.days];
  document.getElementById('habit-modal-title').textContent = 'Edit Habit';
  document.getElementById('h-name').value = h.name;
  document.getElementById('h-emoji').value = h.emoji;
  document.getElementById('h-meta').value = h.meta || '';
  updateDayPicker();
  document.getElementById('modal-habit').classList.remove('hidden');
  setTimeout(() => document.getElementById('h-name').focus(), 150);
}

function closeHabitModal() { document.getElementById('modal-habit').classList.add('hidden'); }

function toggleDay(d) {
  const idx = selectedDays.indexOf(d);
  if(idx >= 0) selectedDays.splice(idx, 1);
  else selectedDays.push(d);
  updateDayPicker();
}

function toggleAllDays() {
  selectedDays = selectedDays.length === 7 ? [] : [0,1,2,3,4,5,6];
  updateDayPicker();
}

function updateDayPicker() {
  document.querySelectorAll('.day-btn[data-day]').forEach(btn => {
    const d = parseInt(btn.dataset.day);
    btn.classList.toggle('selected', selectedDays.includes(d));
  });
}

function saveCustomHabit() {
  const name = document.getElementById('h-name').value.trim();
  if(!name) { showToast('Need a name!'); return; }
  const emoji = document.getElementById('h-emoji').value.trim() || '⭐';
  const meta  = document.getElementById('h-meta').value.trim();
  const days  = selectedDays.length === 7 ? 'daily' : [...selectedDays].sort((a,b)=>a-b);

  if(editingHabitId) {
    const idx = customHabits.findIndex(h => h.id === editingHabitId);
    if(idx >= 0) customHabits[idx] = {...customHabits[idx], name, emoji, meta, days};
  } else {
    customHabits.push({id: uid(), name, emoji, meta, days, color: EARTHY[customHabits.length % EARTHY.length], enabled: true});
  }
  saveProfileData();
  closeHabitModal();
  renderCustomHabitsList();
  showToast('Habit saved ✓');
}

['h-name','h-emoji','h-meta'].forEach(id => {
  document.getElementById(id).addEventListener('keydown', e => { if(e.key==='Enter') saveCustomHabit(); });
});

// ── MEASUREMENTS ──
const MEASURE_SPOTS_DATA = MEASUREMENT_SPOTS;

function renderMeasurementSpots() {
  const latest = measurements[measurements.length - 1];
  const container = document.getElementById('measure-spots');
  container.innerHTML = MEASURE_SPOTS_DATA.map(s => {
    const val = latest?.spots?.[s.id];
    return `<div class="measure-spot">
      <div class="spot-color" style="background:${s.color}"></div>
      <div class="spot-info">
        <div class="spot-name">${s.name}</div>
        <div class="spot-desc">${s.desc}</div>
      </div>
      <div class="spot-value ${val?'':'empty'}">${val ? val+'"' : '—'}</div>
    </div>`;
  }).join('');
}

function renderMeasurementHistory() {
  const container = document.getElementById('measure-history');
  if(!measurements.length) {
    container.innerHTML = `<div class="measure-history-title">No measurements logged yet</div>`;
    return;
  }
  container.innerHTML = `<div class="measure-history-title">History</div>` +
    [...measurements].reverse().slice(0,5).map(m => {
      const vals = MEASURE_SPOTS_DATA
        .filter(s => m.spots?.[s.id])
        .map(s => `${s.name}: ${m.spots[s.id]}"`)
        .join('<br>');
      return `<div class="measure-log-row">
        <div class="measure-log-date">${new Date(m.date+'T12:00:00').toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})}</div>
        <div class="measure-log-vals">${vals||'—'}</div>
      </div>`;
    }).join('');
}

function logMeasurement() {
  const dateStr = new Date().toLocaleDateString('en-US',{weekday:'long',month:'long',day:'numeric'});
  document.getElementById('measure-modal-date').textContent = `Logging for ${dateStr}`;
  const latest = measurements[measurements.length-1];
  const inputs = document.getElementById('measure-inputs');
  inputs.innerHTML = MEASURE_SPOTS_DATA.map(s => `
    <div class="measure-input-row">
      <div class="measure-input-label">${s.name}<span>${s.desc}</span></div>
      <input class="measure-num-input" type="number" inputmode="decimal" min="1" max="100" step="0.1"
        placeholder="—" id="mi-${s.id}" value="${latest?.spots?.[s.id]||''}">
    </div>`).join('');
  document.getElementById('modal-measure').classList.remove('hidden');
}

function closeMeasureModal() { document.getElementById('modal-measure').classList.add('hidden'); }

function saveMeasurement() {
  const date = todayKey();
  const spots = {};
  MEASURE_SPOTS_DATA.forEach(s => {
    const v = document.getElementById(`mi-${s.id}`)?.value;
    if(v) spots[s.id] = parseFloat(v);
  });
  if(!Object.keys(spots).length) { showToast('Enter at least one measurement'); return; }
  const idx = measurements.findIndex(m => m.date === date);
  if(idx >= 0) measurements[idx] = {date, spots};
  else measurements.push({date, spots});
  lSet(measureStoreKey(), measurements);
  closeMeasureModal();
  renderMeasurementSpots();
  renderMeasurementHistory();
  showToast('Measurements saved 📏');
}

// ── WEIGHT ──
function renderWeightHistory() {
  const container = document.getElementById('weight-history');
  if(!weights.length) {
    container.innerHTML = `<div style="font-size:12px;color:var(--muted);font-weight:500;padding:4px 0;">No weight logs yet. Tap + Log to start.</div>`;
    return;
  }
  container.innerHTML = [...weights].reverse().slice(0,8).map((w, i, arr) => {
    const prev = arr[i+1];
    let delta = '', deltaClass = 'same';
    if(prev) {
      const diff = (w.weight - prev.weight).toFixed(1);
      if(diff < 0) { delta = `▼ ${Math.abs(diff)} lbs`; deltaClass = 'down'; }
      else if(diff > 0) { delta = `▲ ${diff} lbs`; deltaClass = 'up'; }
      else { delta = '— no change'; deltaClass = 'same'; }
    }
    return `<div class="weight-row">
      <div class="weight-date">${new Date(w.date+'T12:00:00').toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})}</div>
      <div class="weight-right">
        <div class="weight-val">${w.weight} lbs</div>
        ${delta ? `<div class="weight-delta ${deltaClass}">${delta}</div>` : ''}
        ${w.note ? `<div class="weight-note">${w.note}</div>` : ''}
      </div>
    </div>`;
  }).join('');
}

function logWeight() {
  const dateStr = new Date().toLocaleDateString('en-US',{weekday:'long',month:'long',day:'numeric'});
  document.getElementById('weight-modal-date').textContent = `Logging for ${dateStr}`;
  const last = weights[weights.length-1];
  document.getElementById('w-weight').value = last?.weight || '';
  document.getElementById('w-note').value = '';
  document.getElementById('modal-weight').classList.remove('hidden');
  setTimeout(() => document.getElementById('w-weight').focus(), 150);
}

function saveWeight() {
  const val = document.getElementById('w-weight').value;
  if(!val) { showToast('Enter a weight'); return; }
  const note = document.getElementById('w-note').value.trim();
  const date = todayKey();
  const entry = {date, weight: parseFloat(val), note};
  const idx = weights.findIndex(w => w.date === date);
  if(idx >= 0) weights[idx] = entry;
  else weights.push(entry);
  weights.sort((a,b) => a.date.localeCompare(b.date));
  lSet(weightStoreKey(), weights);
  document.getElementById('modal-weight').classList.add('hidden');
  renderWeightHistory();
  showToast('Weight logged ⚖️');
}

document.getElementById('w-weight').addEventListener('keydown', e => { if(e.key==='Enter') saveWeight(); });

